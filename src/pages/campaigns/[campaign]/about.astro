---
import { getLiveEntry, render } from 'astro:content';
import type { CampaignContentLiveEntryData } from '~/lib/campaign-content-live-loader';
import CampaignsContentLayout from '@layouts/CampaignsContentLayout.astro';
import {
  buildCampaignContentPageModel,
  type CampaignContentPageLiveEntryGetter,
  type CampaignContentPageViewer,
} from '~/lib/campaign-content-page';
import { getRequestSession } from '~/lib/auth-session';
import { createCampaignRequestAccessResolver } from '~/lib/campaign-request-access';

// Campaign About: rendered as a normal Campaign Content Item (not a second gate/settings doc).
const ABOUT_DOCUMENT_ID = 'about';

const { campaign } = Astro.params;
const campaignSlug = campaign ?? '';

const session = await getRequestSession(Astro.request, Astro.locals);
const viewer: CampaignContentPageViewer = session
  ? { kind: 'authenticated', userId: session.user.id, traceId: session.session.id }
  : { kind: 'anonymous' };

const accessResolver = await createCampaignRequestAccessResolver({
  request: Astro.request,
  locals: Astro.locals,
  hostname: Astro.url.hostname,
});
const getCampaignAccessRole = async (slug: string) => {
  const { isMember, isGm } = await accessResolver.hasCampaignAccess(slug);
  return isGm ? 'gm' : isMember ? 'member' : 'anonymous';
};

const model = await buildCampaignContentPageModel({
  campaignSlug,
  documentId: ABOUT_DOCUMENT_ID,
  viewer,
  getCampaignAccessRole,
  getLiveEntry: getLiveEntry as unknown as CampaignContentPageLiveEntryGetter,
});

Astro.response.status = model.httpStatus;

let Content: any = null;
if (model.entry && model.canView) {
  try {
    ({ Content } = await render(model.entry as any));
  } catch (error) {
    console.error('campaign.about.render_unavailable', {
      campaignSlug,
      message: error instanceof Error ? error.message : 'unknown error',
    });
  }
}

const entryData = (model.entry?.data ?? null) as CampaignContentLiveEntryData | null;
const layoutContent = entryData ?? {
  title: 'About this campaign',
  excerpt: 'Campaign about content is temporarily unavailable or restricted.',
  authors: ['World of Aletheia'],
  visibility: 'gm',
  tags: [],
  campaign: campaignSlug,
};

const title = entryData?.title ?? 'About this campaign';
const loginHref = `/login?next=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`;

const isRestricted = model.reason === 'gate_blocked';
const isNotFound = model.reason === 'not_found' || model.reason === 'visibility_mismatch';
const isUnavailable = model.reason === 'unavailable' || model.reason === 'source_error';
---

<CampaignsContentLayout content={layoutContent} title={title} robots={model.robots} showContextMetadata={model.canView}>
  {model.canView && Content ? (
    <article class="reading-prose">
      <nav class="not-prose mb-6 text-sm meta-muted">
        <a href="/campaigns" class="hover:text-primary">Campaigns</a>
        <span class="mx-2">/</span>
        <a href={`/campaigns/${campaignSlug}`} class="hover:text-primary">{campaignSlug}</a>
        <span class="mx-2">/</span>
        <span class="font-medium text-ink-900">About</span>
      </nav>
      <Content />
    </article>
  ) : isRestricted ? (
    <article class="reading-prose">
      <h2>Restricted campaign content</h2>
      <p>
        This campaign is restricted to campaign members. Sign in with your account and ensure you have
        the required campaign access level.
      </p>
      <p><a href={loginHref} class="ui-button ui-button--primary ui-button--sm">Sign in to continue</a></p>
    </article>
  ) : isNotFound ? (
    <article class="reading-prose">
      <h2>About page not found</h2>
      <p>This campaign does not have an about page in the current publication environment.</p>
      <p><a href={`/campaigns/${campaignSlug}`} class="ui-button ui-button--secondary ui-button--sm">Back to campaign</a></p>
    </article>
  ) : (
    <article class="reading-prose">
      <h2>Campaign temporarily unavailable</h2>
      <p>Campaign content is temporarily unavailable. Please try again later.</p>
      <p><a href={`/campaigns/${campaignSlug}`} class="ui-button ui-button--secondary ui-button--sm">Back to campaign</a></p>
    </article>
  )}
</CampaignsContentLayout>
